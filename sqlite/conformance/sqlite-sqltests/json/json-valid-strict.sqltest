@database :memory:

# One-argument json_valid() accepts only canonical RFC 8259 text.
# JSON5-only syntax parses fine in the other JSON functions but must
# return 0 here, matching SQLite.

test json_valid_accepts_strict_document {
    SELECT json_valid('{"a":5,"b":6}');
}
expect {
    1
}

test json_valid_rejects_unquoted_object_keys {
    SELECT json_valid('{a:5,b:6}');
}
expect {
    0
}

test json_valid_rejects_object_trailing_comma {
    SELECT json_valid('{"a":5, "b":6, }');
}
expect {
    0
}

test json_valid_rejects_array_trailing_comma {
    SELECT json_valid('[5, 6,]');
}
expect {
    0
}

test json_valid_rejects_single_quoted_strings {
    SELECT json_valid('{"a": ''abcd''}');
}
expect {
    0
}

test json_valid_rejects_escaped_newline_in_string {
    SELECT json_valid('{"a": "abc' || char(0x5c, 0x0a) || 'xyz"}');
}
expect {
    0
}

test json_valid_rejects_raw_control_character_in_string {
    SELECT json_valid('"abc' || char(1) || 'xyz"');
}
expect {
    0
}

test json_valid_rejects_plus_signed_number {
    SELECT json_valid('{"x":+5}');
}
expect {
    0
}

test json_valid_rejects_hex_number {
    SELECT json_valid('{"x":0x35}');
}
expect {
    0
}

test json_valid_rejects_trailing_dot_number {
    SELECT json_valid('{"x":4.}');
}
expect {
    0
}

test json_valid_rejects_infinity_literal {
    SELECT json_valid('{"x":Infinity}');
}
expect {
    0
}

test json_valid_rejects_nan_literal {
    SELECT json_valid('{"x":NaN}');
}
expect {
    0
}

test json_valid_rejects_comments {
    SELECT json_valid('{"a":1} /*c*/'), json_valid('/*c*/ 1'), json_valid('// c
1');
}
expect {
    0|0|0
}

test json_valid_accepts_standard_escapes_and_whitespace {
    SELECT json_valid('"aA\n\/b"'), json_valid(char(9,10,13,32)||'1');
}
expect {
    1|1
}

test json_valid_number_arguments_are_valid {
    SELECT json_valid(123), json_valid(4.5);
}
expect {
    1|1
}

test json_valid_infinite_float_argument_is_invalid {
    SELECT json_valid(9e999), json_valid(-9e999);
}
expect {
    0|0
}

test json_valid_jsonb_blob_is_invalid_for_one_arg_form {
    SELECT json_valid(jsonb('{"a":1}'));
}
expect {
    0
}

test json_valid_non_jsonb_blob_validates_as_text {
    SELECT json_valid(x'7B7D'), json_valid(x'ABCD');
}
expect {
    1|0
}

# x'2033343535' is the text " 3455". The raw blob decides whether it is
# JSONB; the leading space says it is not, so it validates as text even
# though the bytes after the space happen to form a JSONB integer.
test json_valid_blob_is_classified_before_whitespace {
    SELECT json_valid(x'2033343535');
}
expect {
    1
}

# x'5B6E756C6C5D' is the text "[null]", whose first byte also parses as
# a JSONB array header claiming the whole blob. Text can only
# masquerade like that with a '{', '[' or digit first byte and a small
# payload, and there full validation decides: this one fails it and is
# read as text.
test json_valid_ambiguous_small_blob_falls_back_to_text {
    SELECT json_valid(x'5B6E756C6C5D');
}
expect {
    1
}

test json_valid_error_position_still_json5_lenient {
    SELECT json_valid('{"x":+0}'), NOT json_error_position('{"x":+0}');
}
expect {
    0|1
}

# Two-argument json_valid(X, Y): Y is a bitmask picking which
# representations count as valid (1 = strict RFC 8259 text, 2 = JSON5
# text, 4 = blob that superficially looks like JSONB, 8 = blob that is
# valid JSONB).

test json_valid_flag2_accepts_json5_text {
    SELECT json_valid('{a:1}', 1), json_valid('{a:1}', 2), json_valid('{"a":1}', 1);
}
expect {
    0|1|1
}

test json_valid_blob_flags_match_jsonb_blobs_only {
    SELECT json_valid(jsonb('{"a":1}'), 2), json_valid(jsonb('{"a":1}'), 4),
           json_valid(jsonb('{"a":1}'), 8), json_valid(x'ABCD', 4), json_valid(x'ABCD', 8);
}
expect {
    0|1|1|0|0
}

# x'3B133132' has a valid outer JSONB wrapper (ARRAY of 3 payload
# bytes) around malformed contents: flag 4 only looks at the wrapper,
# flag 8 validates all the way down.
test json_valid_flag4_is_shallow_flag8_is_deep {
    SELECT json_valid(x'3B133132', 4), json_valid(x'3B133132', 8);
}
expect {
    1|0
}

# x'2033343535' is the text " 3455". The raw blob decides whether it is
# JSONB, so the leading space makes this text, not a JSONB integer.
test json_valid_flags_classify_blob_before_whitespace {
    SELECT json_valid(x'2033343535', 1), json_valid(x'2033343535', 2),
           json_valid(x'2033343535', 4), json_valid(x'2033343535', 8);
}
expect {
    1|1|0|0
}

# x'5B6E756C6C5D' is the text "[null]": its first byte looks like a
# JSONB array header, but small '{'/'['/digit-prefixed blobs are fully
# validated before counting as JSONB, so this one is text under every
# flag.
test json_valid_flags_ambiguous_small_blob_is_text {
    SELECT json_valid(x'5B6E756C6C5D', 1), json_valid(x'5B6E756C6C5D', 2),
           json_valid(x'5B6E756C6C5D', 4), json_valid(x'5B6E756C6C5D', 8);
}
expect {
    1|1|0|0
}

test json_valid_text_never_matches_blob_flags {
    SELECT json_valid('[1]', 4), json_valid('[1]', 8), json_valid('[1,2,3]', 6);
}
expect {
    0|0|1
}

test json_valid_flags_combine_as_bitmask {
    SELECT json_valid('{a:1}', 3), json_valid('{a:1}', 15), json_valid(jsonb('{"a":1}'), 12);
}
expect {
    1|1|1
}

test json_valid_two_arg_numbers_render_as_text {
    SELECT json_valid(123, 1), json_valid(123, 2), json_valid(123, 4),
           json_valid(9e999, 1), json_valid(9e999, 2);
}
expect {
    1|1|0|0|1
}

test json_valid_two_arg_null_x_is_null {
    SELECT json_valid(NULL, 1) IS NULL;
}
expect {
    1
}

test json_valid_flags_coerce_numerically {
    SELECT json_valid('{}', '2'), json_valid('{}', 2.5);
}
expect {
    1|1
}

# TEXT flags take their leading integer prefix, like sqlite3_value_int:
# '1e1' means flag 1, not 10, so a JSONB blob fails it.
test json_valid_text_flags_use_integer_prefix {
    SELECT json_valid(x'2B1331', '1e1'), json_valid('{}', '1e1');
}
expect {
    0|1
}

test json_valid_flags_zero_is_an_error {
    SELECT json_valid('{}', 0);
}
expect error {
    ^FLAGS parameter to json_valid\(\) must be between 1 and 15$
}

test json_valid_flags_sixteen_is_an_error {
    SELECT json_valid('{}', 16);
}
expect error {
    ^FLAGS parameter to json_valid\(\) must be between 1 and 15$
}

test json_valid_flags_null_is_an_error_even_for_null_x {
    SELECT json_valid(NULL, NULL);
}
expect error {
    ^FLAGS parameter to json_valid\(\) must be between 1 and 15$
}

# json_quote must escape control characters so its output is always
# strict RFC 8259 text: \b \f \n \r \t for the named ones, \u00xx for
# the rest. The forward slash is not escaped.

test json_quote_escapes_control_characters {
    SELECT json_quote('a' || char(1) || 'z'), json_quote('a' || char(11) || 'z'),
           json_quote('a' || char(31) || 'z');
}
expect {
    "a\u0001z"|"a\u000bz"|"a\u001fz"
}

test json_quote_uses_short_escapes_for_named_controls {
    SELECT json_quote('a' || char(10) || 'z'), json_quote('a' || char(9) || 'z'),
           json_quote('a' || char(13) || 'z'), json_quote('a' || char(8) || 'z'),
           json_quote('a' || char(12) || 'z');
}
expect {
    "a\nz"|"a\tz"|"a\rz"|"a\bz"|"a\fz"
}

test json_quote_leaves_slash_alone {
    SELECT json_quote('a/b'), json_quote('a"b');
}
expect {
    "a/b"|"a\"b"
}

test json_quote_output_is_always_strict_json {
    WITH RECURSIVE c(x) AS (VALUES(1) UNION ALL SELECT x+1 FROM c WHERE x < 0x1f)
    SELECT sum(json_valid(json_quote('a' || char(x) || 'z'))) FROM c;
}
expect {
    31
}

# JSON5 strings may span lines by escaping any of the four line
# terminators: LF, CR, CRLF, U+2028 and U+2029. The continuation is
# dropped from the string value.

test json5_line_continuation_lf {
    SELECT ('{a: "abc' || char(0x5c, 0x0a) || 'xyz"}') ->> 'a';
}
expect {
    abcxyz
}

test json5_line_continuation_cr {
    SELECT ('{a: "abc' || char(0x5c, 0x0d) || 'xyz"}') ->> 'a';
}
expect {
    abcxyz
}

test json5_line_continuation_crlf_is_one_terminator {
    SELECT ('{a: "abc' || char(0x5c, 0x0d, 0x0a) || 'xyz"}') ->> 'a';
}
expect {
    abcxyz
}

test json5_line_continuation_u2028_u2029 {
    SELECT ('{a: "abc' || char(0x5c, 0x2028) || 'xyz"}') ->> 'a',
           ('{a: "abc' || char(0x5c, 0x2029) || 'xyz"}') ->> 'a';
}
expect {
    abcxyz|abcxyz
}

test json5_line_continuation_json_rendering {
    SELECT json('{a: "abc' || char(0x5c, 0x0d) || 'xyz"}');
}
expect {
    {"a":"abcxyz"}
}

test json5_escaped_double_quote_unescapes {
    SELECT ('{a: "abc' || char(0x5c, 0x22) || 'xyz"}') ->> 'a';
}
expect {
    abc"xyz
}

# The JSON5 vertical-tab escape decodes to U+000B on extraction, but
# json() renders it with the horizontal-tab escape u0009, matching the
# SQLite version we target (upstream fixed the escape in 3.51.2).

test json5_vertical_tab_escape_decodes_to_0x0b {
    SELECT hex(('{a: "x' || char(0x5c, 0x76) || 'z"}') ->> 'a'),
           json('{a: "x' || char(0x5c, 0x76) || 'z"}');
}
expect {
    780B7A|{"a":"x\u0009z"}
}

# JSON5 numbers with a trailing decimal point: the canonical rendering
# inserts the missing zero after the dot, before any exponent. Numbers
# whose only JSON5 feature is a leading '+' stay untouched.

test json5_trailing_dot_gets_zero_inserted {
    SELECT json('{x: 4.}'), json('{x: 4.e0}'), json('{x: +4.e1}'), json('{x: -4.e2}');
}
expect {
    {"x":4.0}|{"x":4.0e0}|{"x":4.0e1}|{"x":-4.0e2}
}

# CAST to TEXT so the engine formats the REAL results; the JS driver
# would otherwise render 4.0 as the bare number 4.
test json5_trailing_dot_extracted_value {
    SELECT CAST(('{x: 4.e0}')->>'x' AS TEXT),
           CAST(('{x: +4.e1}')->>'x' AS TEXT),
           CAST(('{x: -4.e2}')->>'x' AS TEXT);
}
expect {
    4.0|40.0|-400.0
}

test json5_plus_only_numbers_stay_canonical {
    SELECT json('{x: +4e1}'), json('{x: +5.5}'), json('{x: 4.E2}');
}
expect {
    {"x":4e1}|{"x":5.5}|{"x":4.0E2}
}

# JSON5 Infinity: -> renders the JSON text 9e999, while ->> and
# json_extract return the infinite REAL.

test json5_infinity_arrow_renders_9e999 {
    SELECT '{x:Infinity}'->'x', typeof('{x:Infinity}'->'x');
}
expect {
    9e999|text
}

test json5_infinity_double_arrow_returns_real {
    SELECT '{x:Infinity}'->>'x', typeof('{x:Infinity}'->>'x'),
           '{x:-Infinity}'->>'x', json_extract('{x:Infinity}','$.x');
}
expect {
    Inf|real|-Inf|Inf
}

test json5_infinity_document_renderings {
    SELECT json('Infinity'), json('{x:-Infinity}'), json('{"x":9e999}'), json_quote(9e999);
}
expect {
    9e999|{"x":-9e999}|{"x":9e999}|9.0e+999
}

# A leading-plus overflow number is an ordinary JSON5 number, not the
# Infinity literal: its text must survive rendering unchanged even
# though its value is infinite.
test json5_plus_overflow_number_keeps_its_text {
    SELECT '+9.0e+999'->'$', '{x: +9.0e+999}'->'$.x', typeof('+9.0e+999'->>'$');
}
expect {
    9.0e+999|9.0e+999|real
}

# Unquoted JSON5 object keys follow SQLite's identifier rules: ASCII
# letters, '_' and '$' may start one, digits may only continue one,
# non-ASCII characters are accepted, everything else is malformed.

test json5_unquoted_key_charset {
    SELECT json_valid('{x1:5}',2), json_valid('{_x:5}',2), json_valid('{$x:5}',2),
           json_valid('{éx:5}',2);
}
expect {
    1|1|1|1
}

test json5_unquoted_key_rejects_illegal_characters {
    SELECT json_valid('{1x:5}',2), json_valid('{x-y:5}',2), json_valid('{x.y:5}',2),
           json_valid('{x/y:5}',2), json_valid('{:5}',2), json_valid('{a'||char(1)||':1}',2);
}
expect {
    0|0|0|0|0|0
}

test json5_unquoted_key_slash_is_malformed {
    SELECT json('{ MNO_123/xyz : 789 }');
}
expect error {
    ^(Parse error: )?malformed JSON$
}

# \uXXXX escapes may appear anywhere in an unquoted key, whatever they
# decode to; rendering keeps the escape and path matching decodes it.
# No other escape is allowed in a key.
test json5_unquoted_key_accepts_unicode_escapes {
    SELECT json('{' || char(0x5c) || 'u0061:1}'),
           ('{' || char(0x5c) || 'u0061:1}')->>'a',
           ('{a' || char(0x5c) || 'u0062:1}')->>'ab',
           json('{' || char(0x5c) || 'u0031:1}');
}
expect {
    {"\u0061":1}|1|1|{"\u0031":1}
}

test json5_unquoted_key_rejects_other_escapes {
    SELECT json_valid('{a' || char(0x5c) || 'tb:1}', 2),
           json_valid('{a' || char(0x5c) || 'x62:1}', 2),
           json_valid('{' || char(0x5c) || 'u061:1}', 2);
}
expect {
    0|0|0
}

# A comment directly after an unquoted key acts as whitespace.
test json5_unquoted_key_ends_at_comment {
    SELECT json('{x/*c*/:1}'), json('{x//c' || char(10) || ':1}'), json_valid('{x/y:1}', 2);
}
expect {
    {"x":1}|{"x":1}|0
}

# Array locators counting from the end: leading zeros in [#-n] keep the
# sign, and [#-0] addresses the same one-past-the-end position as [#].

test json_path_from_end_leading_zeros_keep_sign {
    SELECT json_extract('{"b":[1,[2,3],4]}','$.b[#-02]'),
           json_extract('{"b":[1,[2,3],4]}','$.b[#-000001]'),
           json_extract('{"b":[1,2]}','$.b[#-00002]');
}
expect {
    [2,3]|4|1
}

test json_path_minus_zero_is_one_past_the_end {
    SELECT json_remove('{"b":[1,2]}','$.b[#-0]'),
           json_extract('{"b":[1,2]}','$.b[#-0]') IS NULL;
}
expect {
    {"b":[1,2]}|1
}

# Appending with [#] or the exact one-past-the-end index works for both
# json_set and json_insert; larger indexes and from-end locators are
# no-ops for insert-only mode.

test json_array_append_with_hash_and_end_index {
    SELECT json_insert('{"b":[1,2]}','$.b[#]','X'),
           json_insert('{"b":[1,2]}','$.b[2]','X'),
           json_set('{"b":[1,2]}','$.b[#]','X','$.b[#]','Y'),
           json_insert('[1,2]','$[#]','X'),
           json_insert('{"b":[[2,3]]}','$.b[0][2]','X');
}
expect {
    {"b":[1,2,"X"]}|{"b":[1,2,"X"]}|{"b":[1,2,"X","Y"]}|[1,2,"X"]|{"b":[[2,3,"X"]]}
}

test json_array_append_out_of_range_is_noop {
    SELECT json_insert('{"b":[1,2]}','$.b[5]','X'),
           json_insert('{"b":[1,2]}','$.b[#-1]','X'),
           json_insert('{"b":[[2,3]]}','$.b[0][5]','X');
}
expect {
    {"b":[1,2]}|{"b":[1,2]}|{"b":[[2,3]]}
}

test json_appended_document_stays_well_formed {
    SELECT json_extract(json_set('{"b":[1,2]}','$.b[#]','X'),'$.b[2]'),
           json(jsonb_set('{"b":[1,2]}','$.b[#]','X'));
}
expect {
    X|{"b":[1,2,"X"]}
}

# An 11-byte array payload sits exactly on a JSONB header size-format
# boundary: appending grows the array's own header, which shifts the
# contents. The appended value and the document must survive that.
test json_append_across_array_header_size_boundary {
    SELECT json_extract(json_set(json('{"b":' || json_array(
               null,null,null,null,null,null,null,null,null,null,null) || '}'),
               '$.b[#]', 'X'), '$.b[10]', '$.b[11]'),
           json_valid(jsonb_set(json('{"b":' || json_array(
               null,null,null,null,null,null,null,null,null,null,null) || '}'),
               '$.b[11]', 'X'), 8);
}
expect {
    [null,"X"]|1
}

# Malformed paths report SQLite's message format, with the path quoted.

test json_bad_path_error_message_format {
    SELECT json_extract('{"b":[1]}', '$.b[#-]');
}
expect error {
    ^(Parse error: )?bad JSON path: '\$\.b\[#-\]'$
}

# Apostrophes in the path are doubled in the message, like SQLite's %Q.
test json_bad_path_message_doubles_apostrophes {
    SELECT json_extract('{}', 'x''y''z');
}
expect error {
    ^(Parse error: )?bad JSON path: 'x''y''z'$
}

# subtype() reports 74 ('J') for TEXT a JSON function produced, and 0
# for everything else — including JSONB blobs, whose acceptance as
# arguments is purely structural.

test subtype_reports_json_text_only {
    SELECT subtype(json('{}')), subtype(jsonb('{}')), subtype('{}'),
           subtype(1), subtype(NULL), subtype(json_extract('{"a":[1]}','$.a')),
           subtype(json_extract('{"a":1}','$.a'));
}
expect {
    74|0|0|0|0|74|0
}

test double_arrow_result_never_carries_subtype {
    SELECT subtype('{"a":[7,8]}'->'a'), subtype('{"a":[7,8]}'->>'a'),
           typeof('{"a":[7,8]}'->>'a');
}
expect {
    74|0|text
}

test jsonb_blob_arguments_accepted_structurally {
    SELECT json_array(jsonb_array(1,2)), json(jsonb_array(json_array(1,2))),
           json_object('ex', jsonb('[52,3.14159]')),
           json_set('{"a":2,"c":4}', '$.c', jsonb('[97,96]')),
           json_array(x'0B'), json_quote(x'0B');
}
expect {
    [[1,2]]|[[1,2]]|{"ex":[52,3.14159]}|{"a":2,"c":[97,96]}|[[]]|[]
}

test non_jsonb_blob_arguments_error {
    SELECT json_array(x'313233');
}
expect error {
    ^(Runtime error: )?(Parse error: )?JSON cannot hold BLOB values$
}

# Document arguments accept blobs everywhere: JSONB blobs directly,
# and other blobs as JSON text (x'313233' is the text "123").
test patch_and_error_position_accept_blobs {
    SELECT json_patch(jsonb('{"a":1}'), jsonb('{"b":2}')),
           json(jsonb_patch(jsonb('{"a":1}'), jsonb('{"b":2}'))),
           json_patch(x'313233', '{}'),
           json_error_position(jsonb('{"a":1}')),
           json_error_position(x'313233'), json_error_position(x'ABCD');
}
expect {
    {"a":1,"b":2}|{"a":1,"b":2}|{}|0|0|1
}

# Only text a JSON function produced as a JSON value carries the 'J'
# subtype: json_quote and json_patch results do, while metadata text
# from json_type and display text from json_pretty do not.
test subtype_marks_json_values_not_metadata {
    SELECT subtype(json_quote('x')), subtype(json_quote(5)), subtype(json_quote(NULL)),
           subtype(json_patch('{}','null')), subtype(json_patch('{"a":1}','{"b":2}')),
           subtype(json_type('{}')), subtype(json_type('[3]','$[0]')),
           subtype(json_pretty('{}'));
}
expect {
    74|74|74|74|74|0|0|0
}

# Unmarked json_type output nests as a plain string.
test json_type_output_nests_as_text {
    SELECT json_array(json_type('{}'));
}
expect {
    ["object"]
}
